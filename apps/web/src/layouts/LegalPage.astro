---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import Layout from "./Layout.astro";

type Localized = { en: string; es: string };

interface Props {
	title: Localized;
	description: Localized;
	/** For a page revised after the other legal documents. */
	updated?: Localized;
}

// SSR: follow the visitor's landing-page language choice. Spanish copy goes in
// the page's `es` slot, English in the default one.
const locale = Astro.cookies.get("litepod-locale")?.value === "es" ? "es" : "en";
const title = Astro.props.title[locale];
const description = Astro.props.description[locale];
const updated = Astro.props.updated;
---

<Layout title={`${title} — Litepod`} description={description} lang={locale}>
	<Header />
	<LocaleSwitch locale={locale} />
	<main
		id="top"
		class="relative z-10 mx-auto min-h-[calc(100dvh-11rem)] w-[calc(100%-2rem)] max-w-[72rem] py-12 sm:w-[calc(100%-3rem)] sm:py-16">
		<article
			class="max-w-[44rem] text-[1.0625rem] leading-[1.7] text-lp-muted [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-[560] [&_h2]:tracking-[-.035em] [&_h2]:text-lp-ink [&_p]:mt-4 [&_p]:max-w-[72ch] [&_ul]:mt-4 [&_ul]:max-w-[72ch] [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_a]:font-semibold [&_a]:text-lp-accent [&_a]:underline-offset-4 hover:[&_a]:underline">
			<h1
				class="text-[clamp(2.25rem,4.6vw,3.5rem)] leading-[1.02] font-[560] tracking-[-.04em] text-lp-ink">
				{title}
			</h1>
			<p class="mt-3 text-sm">
				{locale === "es"
					? `Última actualización: ${updated?.es ?? "31 de octubre de 2026"}`
					: `Last updated: ${updated?.en ?? "October 31, 2026"}`}
			</p>
			{locale === "es" ? <slot name="es" /> : <slot />}
		</article>
	</main>
	<Footer />
</Layout>
