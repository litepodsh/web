---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import Layout from "./Layout.astro";

type Localized = { en: string; es: string };

interface Props {
	title: Localized;
	description: Localized;
}

// SSR: follow the visitor's landing-page language choice. Spanish copy goes in
// the page's `es` slot, English in the default one.
const locale = Astro.cookies.get("litepod-locale")?.value === "es" ? "es" : "en";
const title = Astro.props.title[locale];
const description = Astro.props.description[locale];
---

<Layout title={`${title} — Litepod`} description={description} lang={locale}>
	<Header />
	<LocaleSwitch locale={locale} />
	<main
		id="top"
		class="relative z-10 mx-auto min-h-[calc(100dvh-11rem)] w-[calc(100%-2rem)] max-w-[72rem] py-14 sm:w-[calc(100%-3rem)] sm:py-20">
		<article
			class="lp-float rounded-[2rem] border border-lp-ink/10 bg-lp-surface p-7 sm:p-12 text-[1.0625rem] leading-8 text-lp-muted [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-[560] [&_h2]:tracking-[-.035em] [&_h2]:text-lp-ink [&_p]:mt-4 [&_p]:max-w-[72ch] [&_ul]:mt-4 [&_ul]:max-w-[72ch] [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_a]:font-semibold [&_a]:text-lp-accent [&_a]:underline-offset-4 hover:[&_a]:underline">
			<h1
				class="text-4xl font-[560] tracking-[-.06em] text-lp-ink sm:text-5xl">
				{title}
			</h1>
			<p class="font-mono text-xs">
				{locale === "es" ? "Última actualización: 31 de octubre de 2026" : "Last updated: October 31, 2026"}
			</p>
			{locale === "es" ? <slot name="es" /> : <slot />}
		</article>
	</main>
	<Footer />
</Layout>
