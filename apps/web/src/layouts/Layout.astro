---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Litepod — Infrastructure without a black box",
	image = "/og.png",
	description = "Install Litepod on a server you control, or bring your server to Litepod Cloud while we manage the control plane.",
} = Astro.props;
const site = Astro.site ?? new URL("https://litepod.sh");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

const cookieLocale = Astro.cookies.get("litepod-locale")?.value;
const locale: "en" | "es" = cookieLocale === "es" ? "es" : "en";
const ogLocale = locale === "es" ? "es_ES" : "en_US";
---

<!doctype html>
<html lang={locale} class="dark bg-lp-bg scroll-smooth motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<meta name="theme-color" content="#F4F0E9">
		<script is:inline>
		document.documentElement.classList.add("js");
		document.documentElement.classList.toggle(
			"dark",
			localStorage.getItem("litepod-theme") !== "light",
		);
		</script>
		<meta name="description" content={description}>
		<meta name="robots" content="index, follow">
		<meta name="keywords" content="Litepod, infrastructure, self-hosting, control plane, Litepod Cloud, server, hosting, open source">
		<meta name="author" content="Litepod Studio">
		<title>{title}</title>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Litepod">
		<meta property="og:url" content={canonical}>
		<meta property="og:locale" content={ogLocale}>
		<meta property="og:image" content={ogImage}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content="Litepod console: host your apps and keep control.">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImage}>
		<link rel="canonical" href={canonical}>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Organization",
				name: "Litepod",
				url: site.href,
				logo: new URL("/favicon.svg", site).href,
				description:
					"Infrastructure without a black box. Self-host or bring your own server to Litepod Cloud.",
				sameAs: [
					"https://github.com/litepod",
				],
			})}></script>
		<script
			defer
			src="https://umami.sebasgc.xyz/script.js"
			data-website-id="502eaf9d-5604-439d-bf3a-5e600c48eef9"
			data-performance="true"></script>
		<script
			defer
			src="https://umami.sebasgc.xyz/recorder.js"
			data-website-id="502eaf9d-5604-439d-bf3a-5e600c48eef9"></script>
	</head>
	<body class="min-w-80 bg-lp-bg font-sans text-lp-ink antialiased">
		<a
			href="#top"
			class="sr-only rounded-full bg-lp-ink px-4 py-2 text-sm text-lp-bg focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
			>Skip to content</a
		>
		<slot />
	</body>
</html>
