---
import { about } from "../data/about.mjs";
import LegalPage from "../layouts/LegalPage.astro";

const { en, es } = about;
---

<LegalPage
	title={{ en: en.title, es: es.title }}
	description={{ en: en.description, es: es.description }}
	markdown="/about.md">
	<Fragment>
		{en.intro.map((paragraph) => <p>{paragraph}</p>)}
		<h2>{en.relatedTitle}</h2>
		<p>{en.relatedLead}</p>
		<ul>
			{en.related.map(([name, href, body]) => (
					<li>
						<a href={href} target="_blank" rel="noreferrer">
							{name}
						</a>
						: {body}
					</li>
				))}
		</ul>
		<h2>{en.contactTitle}</h2>
		<p>
			{en.contactLead}
			{" "}<a href={`mailto:${en.contactEmail}`}>{en.contactEmail}</a>.
		</p>
	</Fragment>
	<Fragment slot="es">
		{es.intro.map((paragraph) => <p>{paragraph}</p>)}
		<h2>{es.relatedTitle}</h2>
		<p>{es.relatedLead}</p>
		<ul>
			{es.related.map(([name, href, body]) => (
					<li>
						<a href={href} target="_blank" rel="noreferrer">
							{name}
						</a>
						: {body}
					</li>
				))}
		</ul>
		<h2>{es.contactTitle}</h2>
		<p>
			{es.contactLead}
			{" "}<a href={`mailto:${es.contactEmail}`}>{es.contactEmail}</a>.
		</p>
	</Fragment>
</LegalPage>
