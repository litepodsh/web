---
import LegalCopy from "../components/LegalCopy.astro";
import { legal } from "../data/legal.mjs";
import LegalPage from "../layouts/LegalPage.astro";

const { en, es } = legal.terms;
---

<LegalPage
	title={{ en: en.title, es: es.title }}
	description={{ en: en.description, es: es.description }}
	updated={{ en: en.updated, es: es.updated }}
	markdown="/terms.md">
	<LegalCopy blocks={en.blocks} />
	<Fragment slot="es">
		<LegalCopy blocks={es.blocks} />
	</Fragment>
</LegalPage>
