---
import ArrowChip from "../components/ArrowChip.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import { links } from "../data/landing.mjs";
import { pricing, slotPrice } from "../data/pricing.mjs";
import Layout from "../layouts/Layout.astro";

// SSR: follow the visitor's landing-page language choice.
const locale = Astro.cookies.get("litepod-locale")?.value === "es" ? "es" : "en";
const t = pricing[locale];
const site = Astro.site ?? new URL("https://litepod.sh");
const ctaHref = {
	self: "/#install-command",
	cloud: links.cloud,
	enterprise: "mailto:info@litepod.sh?subject=Litepod%20Enterprise",
};
const schema = [
	{
		"@type": "Product",
		name: "Litepod Cloud",
		description: t.description,
		brand: { "@id": new URL("/#organization", site).href },
		offers: [
			{ "@type": "Offer", name: "Self-hosted", price: "0", priceCurrency: "USD" },
			{
				"@type": "Offer",
				name: "Litepod Cloud",
				price: String(slotPrice),
				priceCurrency: "USD",
				priceSpecification: {
					"@type": "UnitPriceSpecification",
					price: String(slotPrice),
					priceCurrency: "USD",
					unitText: "server slot per month",
					valueAddedTaxIncluded: false,
				},
			},
		],
	},
	{
		"@type": "FAQPage",
		mainEntity: t.faq.map(([q, a]) => ({
			"@type": "Question",
			name: q,
			acceptedAnswer: { "@type": "Answer", text: a },
		})),
	},
];
const check = "m3.5 8.5 3 3 6-7";
---

<Layout title={t.title} description={t.description} lang={locale} schema={schema} markdown="/pricing.md">
	<Header />
	<LocaleSwitch locale={locale} />
	<main class="relative z-10 mx-auto w-[calc(100%-2rem)] max-w-[72rem] sm:w-[calc(100%-3rem)]">
		<section class="pt-14 pb-10 sm:pt-20 sm:pb-12" aria-labelledby="pricing-title">
			<h1
				id="pricing-title"
				class="text-[clamp(2.5rem,5.4vw,4.5rem)] leading-[1] font-[560] tracking-[-.04em] whitespace-pre-line animate-rise">
				{t.h1}
			</h1>
			<p class="mt-5 max-w-[36rem] text-lg leading-[1.55] text-lp-muted animate-reveal">{t.lead}</p>
		</section>

		<!-- Cards are subgrids of the section's 7 rows (label, name, price, pitch, CTA, features, note),
		     so every CTA lines up even when a card has a taller price or pitch. -->
		<section class="grid grid-cols-1 gap-4 md:grid-cols-[.95fr_1.1fr_.95fr] md:gap-x-5 md:gap-y-0" aria-label={t.eyebrow}>
			{
				t.plans.map((plan, index) => {
					const featured = plan.key === "cloud";
					return (
						<article
							class="relative min-w-0 md:row-span-7 md:grid md:grid-rows-subgrid md:gap-y-0"
							data-reveal
							style={`--reveal-i: ${index}`}>
							<div class={`relative flex h-full flex-col overflow-hidden rounded-2xl border bg-lp-surface p-6 sm:p-8 md:row-span-7 md:grid md:grid-rows-subgrid md:gap-y-0 ${featured ? "border-lp-accent" : "border-lp-ink/10"}`}>
								<div class="relative flex flex-wrap items-center justify-between gap-3">
									{plan.label !== plan.name && <p class="text-sm font-medium text-lp-muted">{plan.label}</p>}
									{featured && (
										<span class="inline-flex items-center gap-1.5 rounded-[.5rem] border border-lp-ok/25 bg-lp-ok/10 px-2 py-1 font-mono text-[.625rem] text-lp-ok">
											<span class="size-1.5 rounded-full bg-lp-ok motion-safe:animate-breathe" />
											{t.recommended}
										</span>
									)}
								</div>
								<h2 class="relative mt-5 text-2xl font-[560] tracking-[-.045em]">{plan.name}</h2>
								<p class="relative mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1">
									<span class="text-[clamp(2.75rem,5vw,3.75rem)] leading-none font-[560] tracking-[-.04em] tabular-nums">
										{plan.price}
									</span>
									{plan.key === "cloud" ? (
										<span class="text-[.8125rem] text-lp-muted">
											{t.perMonth}*
										</span>
									) : (
										plan.unit && <span class="text-[.8125rem] text-lp-muted">{plan.unit}</span>
									)}
								</p>
								<p class="relative mt-5 self-start text-sm leading-[1.6] text-lp-muted">{plan.pitch}</p>
								<a
									href={ctaHref[plan.key]}
									{...(plan.key === "cloud" ? { "data-umami-event": "cloud-cta-pricing" } : {})}
									class={`group relative mt-8 inline-flex h-12 w-full items-center justify-between gap-3 rounded-[.75rem] px-5 text-[.9375rem] font-semibold tracking-[-.015em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98] ${featured ? "lp-btn-primary" : "lp-btn-ink"}`}>
									<span>{plan.cta}</span>
									<ArrowChip />
								</a>
								<ul class="relative mt-8 grid content-start gap-2.5">
									{plan.features.map((feature) => (
										<li class="lp-groove-b flex items-start gap-3 pb-2.5 text-sm leading-[1.5]">
											<span class="lp-raised mt-px grid size-5 shrink-0 place-items-center rounded-[.4rem] bg-lp-raised text-lp-accent">
												<svg class="size-3 fill-none stroke-current stroke-2" viewBox="0 0 16 16" aria-hidden="true">
													<path d={check} stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</span>
											<span>{feature}</span>
										</li>
									))}
								</ul>
								<p class="relative mt-auto self-end pt-8 text-xs leading-[1.5] text-lp-muted">
									{plan.note}
									{plan.key === "cloud" && <span class="block">{t.taxNote}</span>}
								</p>
							</div>
						</article>
					);
				})
			}
		</section>

		<section class="lp-band mt-16 py-16 sm:mt-20 sm:py-20" aria-labelledby="saves-title">
			<div class="mb-8" data-reveal>
				<h2
					id="saves-title"
					class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]">
					{t.savesTitle}
				</h2>
				<p class="mt-4 max-w-[34rem] leading-[1.55] text-lp-muted">{t.savesBody}</p>
			</div>
			<div data-reveal>
				<div class="overflow-x-auto rounded-2xl border border-lp-ink/10 bg-lp-surface p-4 sm:p-8">
					<table class="w-full min-w-[34rem] text-left text-sm">
						<thead>
							<tr class="text-xs font-medium text-lp-muted">
								{t.savesCols.map((col, i) => (
									<th class={`pb-4 font-medium ${i === 2 ? "text-lp-ink" : ""}`} scope="col">{col}</th>
								))}
							</tr>
						</thead>
						<tbody>
							{
								t.saves.map(([task, self, cloud], i) => (
									<tr class="lp-groove-t">
										<th scope="row" class="py-4 pr-6 font-medium tracking-[-.01em]">{task}</th>
										<td class="py-4 pr-6 text-lp-muted">{self}</td>
										<td class="py-4">
											<span class="inline-flex items-center gap-2">
												{i < t.saves.length - 1 && (
													<span class="grid size-5 place-items-center rounded-full bg-lp-accent text-lp-accent-ink">
														<svg class="size-3 fill-none stroke-current stroke-2" viewBox="0 0 16 16" aria-hidden="true">
															<path d={check} stroke-linecap="round" stroke-linejoin="round" />
														</svg>
													</span>
												)}
												{cloud}
											</span>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section class="grid gap-8 py-16 sm:grid-cols-[.7fr_1.3fr] sm:py-20" aria-labelledby="faq-title">
			<h2 id="faq-title" class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]" data-reveal>
				{t.faqTitle}
			</h2>
			<div data-reveal style="--reveal-i: 1">
				{
					t.faq.map(([q, a]) => (
						<details class="group lp-groove-b py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-base font-[560] tracking-[-.02em] [&::-webkit-details-marker]:hidden">
								{q}
								<span class="grid size-7 shrink-0 place-items-center text-lp-muted transition-transform duration-500 ease-lp group-open:rotate-45" aria-hidden="true">
									<svg class="size-3.5 fill-none stroke-current stroke-[1.5]" viewBox="0 0 16 16">
										<path d="M8 3v10M3 8h10" stroke-linecap="round" />
									</svg>
								</span>
							</summary>
							<p class="mt-3 max-w-[40rem] text-sm leading-[1.7] text-lp-muted">{a}</p>
						</details>
					))
				}
			</div>
		</section>
	</main>
	<section
		class="hero-field relative z-10 bg-lp-accent py-16 text-lp-accent-ink sm:py-20"
		aria-labelledby="pricing-final">
		<div
			class="mx-auto grid w-[calc(100%-2rem)] max-w-[72rem] gap-8 sm:w-[calc(100%-3rem)] md:grid-cols-[1fr_auto] md:items-end md:gap-14"
			data-reveal>
			<h2
				id="pricing-final"
				class="max-w-[20ch] text-[clamp(2.25rem,4.6vw,3.75rem)] leading-[1.02] font-[560] tracking-[-.04em]">
				{t.finalTitle}
			</h2>
			<div class="flex flex-col items-start gap-4 md:items-end">
				<a
					href={links.cloud}
					data-umami-event="cloud-cta-pricing-final"
					class="group inline-flex h-12 items-center gap-3 rounded-[.75rem] bg-lp-accent-ink px-5 text-[.9375rem] font-semibold tracking-[-.015em] text-lp-accent transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
					<span>{t.finalCloud}</span>
					<ArrowChip />
				</a>
				<a
					href="/#install-command"
					class="group inline-flex items-center gap-2 text-sm font-medium underline-offset-4 hover:underline">
					<span>{t.finalSelf}</span>
					<ArrowChip direction="down" />
				</a>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	// Same scroll reveal as the landing (LandingControls), which this page does not load.
	const nodes = document.querySelectorAll("[data-reveal]");
	if ("IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) =>
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-in");
					observer.unobserve(entry.target);
				}),
			{ rootMargin: "0px 0px -10% 0px" },
		);
		nodes.forEach((node) => observer.observe(node));
	} else nodes.forEach((node) => node.classList.add("is-in"));
</script>
