---
import { alternativesEs, compareUi, litepodFactsEs } from "../../data/alternatives.es.mjs";
import { alternatives as alternativesEn, litepodFacts as litepodFactsEn, reviewed } from "../../data/alternatives.mjs";
import ComparePage from "../../layouts/ComparePage.astro";

const locale = Astro.cookies.get("litepod-locale")?.value === "es" ? "es" : "en";
const alternatives = locale === "es" ? alternativesEs : alternativesEn;
const litepodFacts = locale === "es" ? litepodFactsEs : litepodFactsEn;
const ui = compareUi[locale];
const page = ui.index;

const site = Astro.site ?? new URL("https://litepod.sh");
const entries = Object.entries(alternatives);
const schema = [
	{
		"@type": "ItemList",
		name: "Litepod comparisons",
		itemListElement: entries.map(([key, alt], i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: ui.alternativeOf(alt.name),
			url: new URL(`/alternatives/${key}`, site).href,
		})),
	},
];
---

<ComparePage
	title={page.title}
	h1={page.h1}
	description={page.description}
	reviewed={reviewed}
	crumbs={[{ name: ui.alternatives, path: "/alternatives" }]}
	schema={schema}>
	<p class="text-lp-ink">{page.intro}</p>

	<h2>{page.compare}</h2>
	<ul>
		{
			entries.map(([key, alt]) => (
				<li>
					<a href={`/alternatives/${key}`}>{alt.h1}</a>: {alt.description}
				</li>
			))
		}
	</ul>

	<h2>{page.whatYouGet}</h2>
	<ul>
		{
			page.facts.map(([label, key]) => (
				<li>
					<strong>{label}:</strong> {litepodFacts[key as keyof typeof litepodFacts]}.
				</li>
			))
		}
	</ul>

	<h2>{page.managedTitle}</h2>
	<p>{page.managedBody}</p>
</ComparePage>
