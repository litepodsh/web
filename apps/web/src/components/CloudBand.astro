---
import { links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
const initial = locales.en;
---

<section
	class="hero-field relative z-10 bg-lp-accent py-16 text-lp-accent-ink sm:py-20"
	aria-labelledby="cloud-band-title">
	<div
		class="mx-auto grid w-[calc(100%-2rem)] max-w-[72rem] gap-10 sm:w-[calc(100%-3rem)] md:grid-cols-[1fr_auto] md:items-end md:gap-14"
		data-reveal>
		<div>
			<h2
				id="cloud-band-title"
				class="text-[clamp(2.25rem,4.6vw,3.75rem)] leading-[1.02] font-[560] tracking-[-.04em]"
				data-i18n="ctaTitle">
				{initial.ctaTitle}
			</h2>
			<p class="mt-6 max-w-[36rem] text-[1.0625rem] leading-[1.55]" data-i18n="ctaBody">
				{initial.ctaBody}
			</p>
		</div>
		<div class="flex flex-col items-start gap-4 md:items-end">
			<a
				href={links.cloud}
				data-umami-event="cloud-cta-band"
				class="group inline-flex h-12 items-center gap-3 rounded-[.75rem] bg-lp-accent-ink px-5 text-base font-semibold tracking-[-.015em] text-lp-accent transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
				<span data-i18n="cloudCta">{initial.cloudCta}</span>
				<ArrowChip />
			</a>
			<a
				href={links.docs}
				target="_blank"
				rel="noreferrer"
				class="group inline-flex items-center gap-2 pr-2 text-sm font-medium underline-offset-4 hover:underline">
				<span data-i18n="ctaSecondary">{initial.ctaSecondary}</span>
				<ArrowChip />
			</a>
		</div>
	</div>
</section>
