---
// Header language switch for server-rendered pages (pricing, alternatives). The page
// already renders in the cookie's language, so the switch reflects it, writes the
// cookie and reloads. The landing drives its own switch from LandingControls.
import { locales } from "../data/landing.mjs";

interface Props {
	locale: "en" | "es";
}
const { locale } = Astro.props;
---

<script is:inline define:vars={{ locale, nav: locales[locale].nav }}>
	document.querySelectorAll("[data-i18n^='nav.']").forEach((node) => {
		const value = nav[node.dataset.i18n.slice(4)];
		if (typeof value === "string") node.textContent = value;
	});
	document.querySelectorAll("[data-lang]").forEach((button) =>
		button.setAttribute("aria-pressed", String(button.dataset.lang === locale)),
	);
	const indicator = document.querySelector("[data-language-indicator]");
	if (indicator) indicator.style.transform = `translateX(${locale === "en" ? 0 : 100}%)`;
	const toggle = document.querySelector("[data-language-toggle]");
	if (toggle) toggle.textContent = locale === "en" ? "ES" : "EN";
	const switchTo = (next) => {
		if (next === locale) return;
		document.cookie = `litepod-locale=${next}; max-age=31536000; path=/; SameSite=Lax`;
		location.reload();
	};
	document
		.querySelectorAll("[data-lang]")
		.forEach((button) => button.addEventListener("click", () => switchTo(button.dataset.lang)));
	toggle?.addEventListener("click", () => switchTo(locale === "en" ? "es" : "en"));
</script>
