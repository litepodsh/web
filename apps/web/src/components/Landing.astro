---
import CloudBand from "./CloudBand.astro";
import DemoBand from "./DemoBand.astro";
import DeployTypes from "./DeployTypes.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import LandingControls from "./LandingControls.astro";
import MetricsBand from "./MetricsBand.astro";
import PillRule from "./PillRule.astro";
import PlatformChoice from "./PlatformChoice.astro";
import ServerReach from "./ServerReach.astro";
import Showcase from "./Showcase.astro";
import TemplateKinds from "./TemplateKinds.astro";
---

<!-- Halftone ink maps for the hero devices (scripts/halftone.ts): start them with the HTML. -->
{["v1", "v2", "v3", "v4"].map((v) => <link rel="preload" href={`/hardware/${v}.ink.json`} as="fetch" crossorigin="anonymous" fetchpriority="low" />)}
<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
	<canvas data-halftone-field class="absolute inset-0 size-full"></canvas><svg class="absolute inset-0 size-full opacity-[.04] mix-blend-soft-light">
		<filter id="background-noise">
			<feTurbulence type="fractalNoise" baseFrequency=".8" numOctaves="4" stitchTiles="stitch"
			></feTurbulence>
		</filter>
		<rect width="100%" height="100%" filter="url(#background-noise)"></rect>
	</svg>
</div>
<main
	id="top"
	class="relative z-10 mx-auto w-[calc(100%-2rem)] max-w-[72rem] sm:w-[calc(100%-3rem)]">
	<Hero /><PillRule /><PlatformChoice /><DeployTypes /><TemplateKinds /><ServerReach /><Showcase /><DemoBand /><MetricsBand /><CloudBand />
</main>
<Footer />
<LandingControls />
<script>
	// The halftone canvases are decoration: start them after first paint so they stay off the LCP path.
	const start = () => import("../scripts/halftone");
	if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1500 });
	else setTimeout(start, 200);
</script>
