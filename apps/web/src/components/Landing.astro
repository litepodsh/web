---
import Hero from "./Hero.astro";
import LandingControls from "./LandingControls.astro";
import PlatformChoice from "./PlatformChoice.astro";
import Showcase from "./Showcase.astro";
---

<div
	class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
	aria-hidden="true">
	<i
		class="absolute -top-[20vw] -right-[12vw] size-[74vw] rounded-full bg-lp-acid opacity-18 blur-[7rem] will-change-transform motion-safe:animate-drift-a motion-reduce:animate-none"></i><i
		class="absolute top-[38vh] -left-[30vw] size-[72vw] rounded-full bg-[#376f45] opacity-20 blur-[7rem] will-change-transform motion-safe:animate-drift-b motion-reduce:animate-none"></i><svg
		class="absolute inset-0 size-full opacity-[.035] mix-blend-soft-light">
		<filter id="background-noise">
			<feTurbulence
				type="fractalNoise"
				baseFrequency=".8"
				numOctaves="4"
				stitchTiles="stitch" />
		</filter>
		<rect width="100%" height="100%" filter="url(#background-noise)" />
	</svg>
</div>
<main
	id="top"
	class="relative z-10 mx-auto w-[calc(100%-2rem)] max-w-[86.25rem] py-24 sm:w-[calc(100%-2.5rem)] sm:pt-[8.75rem] sm:pb-[7.5rem]">
	<Hero /><PlatformChoice /><Showcase />
</main>
<LandingControls />
