---
import { locales } from "../data/landing.mjs";
const initial = locales.en;
---

<section class="lp-groove-t py-20 sm:py-32" aria-labelledby="metrics-title">
	<div class="grid grid-cols-1 gap-5 sm:grid-cols-[.7fr_1.3fr] sm:gap-8" data-reveal>
		<p class="font-mono text-[.6875rem] text-lp-label" data-i18n="metrics.eyebrow">
			{initial.metrics.eyebrow}
		</p>
		<h2
			id="metrics-title"
			class="max-w-[18ch] text-[clamp(2.5rem,5vw,4.25rem)] leading-[.94] font-[560] tracking-[-.065em]"
			data-i18n="metrics.title">
			{initial.metrics.title}
		</h2>
	</div>

	<div class="mt-14" data-reveal>
		<div
			class="grid grid-cols-2 gap-px overflow-hidden rounded-[2rem] border border-lp-ink/10 bg-lp-ink/10 sm:grid-cols-4">
			{
				initial.metrics.items.map(([value, label], i) => (
					<div class="bg-lp-surface px-7 py-9">
						<p
							class="font-mono text-[clamp(2rem,4vw,3rem)] leading-none font-[560] tracking-[-.04em] tabular-nums"
							data-i18n={`metrics.items.${i}.0`}>
							{value}
						</p>
						<p
							class="mt-3 font-mono text-[.6875rem] leading-relaxed text-lp-label"
							data-i18n={`metrics.items.${i}.1`}>
							{label}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>
