---
interface Props {
	variant: "dashboard" | "install" | "templates";
	caption: string;
}
const { variant, caption } = Astro.props;
---

<figure
	class="relative m-0 h-full min-h-0 overflow-hidden rounded-[1.25rem] border border-lp-ink/12 bg-lp-surface shadow-[inset_0_1px_0_rgba(255,255,255,.5)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.04)]"
	aria-label={caption}>
	<figcaption
		class="absolute top-4 left-4 z-10 rounded-full border border-lp-ink/12 bg-lp-bg px-2.5 py-1.5 font-mono text-[.625rem] font-semibold uppercase tracking-[.07em] text-lp-muted">
		{caption}
	</figcaption>
	{variant === "install" ? (
			<div class="absolute inset-x-6 top-[4.625rem] grid gap-3.5">
				<i class="h-2 rounded-full bg-lp-ink/12"></i>
				<i class="h-2 w-[78%] rounded-full bg-lp-accent/55"></i>
				<i class="h-2 w-[55%] rounded-full bg-lp-ink/12"></i>
				<i class="h-2 w-[90%] rounded-full bg-lp-ink/12"></i>
			</div>
		) : (
			<div class="absolute inset-x-7 bottom-7 top-[4.625rem] rounded-[.8125rem] border border-lp-ink/12 bg-lp-deep p-3">
				<b class="block h-2.5 w-[36%] rounded-full bg-lp-ink/14"></b>
				<div class="mt-4 grid h-[calc(100%-1.625rem)] grid-cols-[.55fr_1.45fr] gap-2.5">
					<i class="rounded-lg bg-lp-ink/8"></i>
					<span class="grid grid-cols-3 gap-2">
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
						<i class="rounded-lg border border-lp-accent/20 bg-lp-surface"></i>
					</span>
				</div>
			</div>
		)}
</figure>
