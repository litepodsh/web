---
interface Props { variant: 'dashboard' | 'install' | 'templates'; caption: string; }
const { variant, caption } = Astro.props;
---
<figure class="relative m-0 h-full min-h-0 overflow-hidden rounded-[1.25rem] border border-white/10 bg-lp-deep shadow-[inset_0_1px_0_rgba(255,255,255,.04)]" aria-label={caption}><figcaption class="absolute top-4 left-4 z-10 rounded-full border border-white/12 bg-lp-surface px-2.5 py-1.5 font-mono text-[.625rem] font-semibold uppercase tracking-[.07em] text-[#c6d2c7]">{caption}</figcaption>{variant === 'install' ? <div class="absolute inset-x-6 top-[4.625rem] grid gap-3.5"><i class="h-2 rounded-full bg-white/14"></i><i class="h-2 w-[78%] rounded-full bg-lp-acid/28"></i><i class="h-2 w-[55%] rounded-full bg-white/14"></i><i class="h-2 w-[90%] rounded-full bg-white/14"></i></div> : <div class="absolute inset-x-7 bottom-7 top-[4.625rem] rounded-[.8125rem] border border-white/12 bg-[#0a100b] p-3"><b class="block h-2.5 w-[36%] rounded-full bg-white/14"></b><div class="mt-4 grid h-[calc(100%-1.625rem)] grid-cols-[.55fr_1.45fr] gap-2.5"><i class="rounded-lg bg-[#111a12]"></i><span class="grid grid-cols-3 gap-2"><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i><i class="rounded-lg border border-lp-acid/10 bg-[#121d13]"></i></span></div></div>}</figure>
