---
import { locales } from "../data/landing.mjs";
const copy = locales.en.servers;
// Provider logos from simple-icons, self-hosted in public/stack.
// Each entry: [name, light icon file, dark icon file or null].
const providers = [
	["Hetzner", "provider-hetzner", "provider-hetzner_dark"],
	["DigitalOcean", "provider-digitalocean", "provider-digitalocean_dark"],
	["OVHcloud", "provider-ovh", "provider-ovh_dark"],
	["IONOS", "provider-ionos", "provider-ionos_dark"],
	["Azure", "provider-microsoftazure", "provider-microsoftazure_dark"],
	["AWS", "provider-amazonaws", "provider-amazonaws_dark"],
	["Vultr", "provider-vultr", "provider-vultr_dark"],
	["Bare metal", null, null],
];
---

<section class="py-16 sm:py-20" aria-labelledby="servers-title">
	<div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1fr] md:gap-16">
		<div data-reveal>
			<h2
				id="servers-title"
				class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]"
				data-i18n="servers.title">
				{copy.title}
			</h2>
			<p class="mt-6 max-w-[32rem] leading-[1.6] text-lp-muted" data-i18n="servers.body">
				{copy.body}
			</p>
			<ul class="mt-8 flex flex-wrap gap-2" aria-label="Providers">
				{
					providers.map(([name, icon, dark]) => (
						<li class="lp-raised inline-flex h-8 items-center gap-2 rounded-full bg-lp-raised pr-3 pl-2.5 text-xs font-medium text-lp-muted">
							<span class="grid size-4 shrink-0 place-items-center">
								{icon ? (
									<>
										<img
											src={`/stack/${icon}.svg`}
											alt=""
											width="16"
											height="16"
											loading="lazy"
											decoding="async"
											class="size-4 object-contain dark:hidden"
									/>
										<img
											src={`/stack/${dark}.svg`}
											alt=""
											width="16"
											height="16"
											loading="lazy"
											decoding="async"
											class="hidden size-4 object-contain dark:block"
									/>
									</>
								) : (
									<svg
										class="size-4 fill-none stroke-current stroke-[1.5]"
										viewBox="0 0 24 24"
										aria-hidden="true">
										<rect x="3" y="4" width="18" height="7" rx="1.5" />
										<rect x="3" y="13" width="18" height="7" rx="1.5" />
										<path d="M7 7.5h.01M7 16.5h.01" stroke-linecap="round" />
									</svg>
								)}
							</span>
							{name}
						</li>
					))
				}
			</ul>
			<p class="mt-6 inline-flex items-center gap-2 text-xs font-medium text-lp-muted">
				<span class="size-1.5 rounded-full bg-lp-ok"></span>
				<span data-i18n="servers.rootless">{copy.rootless}</span>
			</p>
		</div>

		<div data-reveal style="--reveal-i: 1">
			<p class="text-lg font-[560] tracking-[-.02em]" data-i18n="servers.modesTitle">
				{copy.modesTitle}
			</p>
			<ol class="mt-5">
				{
					copy.modes.map(([title, body], index) => (
						<li class="lp-groove-t py-6">
							<div>
								<strong
									class="block text-lg font-[560] tracking-[-.035em]"
									data-i18n={`servers.modes.${index}.0`}>
									{title}
								</strong>
								<p
									class="mt-1.5 max-w-[36ch] text-sm leading-[1.6] text-lp-muted"
									data-i18n={`servers.modes.${index}.1`}>
									{body}
								</p>
							</div>
						</li>
					))
				}
			</ol>
			<p
				class="mt-4 rounded-[.75rem] border border-lp-ink/10 p-4 text-sm leading-[1.6] text-lp-muted"
				data-i18n="servers.groups">
				{copy.groups}
			</p>
		</div>
	</div>
</section>
