---
import { installCommand, links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
const initial = locales.en;
const card = "relative flex h-full min-w-0 flex-col items-start overflow-hidden rounded-2xl border bg-lp-surface p-6 sm:p-8";
// Fresh install, measured with podman stats. Grid tracks keep the widths to scale.
const containers = [
	["caddy", 24.7],
	["dragonfly", 21.82],
	["api", 16.21],
] as const;
---

<section id="self-host" class="py-14 sm:py-16" aria-labelledby="operating-paths-title">
	<div class="mb-8" data-reveal>
		<h2
			id="operating-paths-title"
			class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]"
			data-i18n="pathsTitle">
			{initial.pathsTitle}
		</h2>
		<p class="mt-4 max-w-[40rem] leading-[1.55] text-lp-muted" data-i18n="intro">{initial.intro}</p>
	</div>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
		<article id="cloud" class={`${card} border-lp-accent`} data-reveal>
			<div class="flex w-full flex-wrap items-center justify-between gap-3">
				<p class="text-sm font-medium text-lp-muted" data-i18n="cloudLabel">{initial.cloudLabel}</p>
				<span class="inline-flex items-center gap-1.5 rounded-[.5rem] bg-lp-ok/10 px-2 py-1 text-xs font-medium text-lp-ok">
					<span class="size-1.5 rounded-full bg-lp-ok"></span>
					<span data-i18n="cloudBadge">{initial.cloudBadge}</span>
				</span>
			</div>
			<h3 class="mt-4 text-2xl leading-[1.15] font-[560] tracking-[-.035em]" data-i18n="cloudTitle">
				{initial.cloudTitle}
			</h3>
			<p class="mt-3 text-[.9375rem] leading-[1.55] text-lp-muted" data-i18n="cloudBody">{initial.cloudBody}</p>
			<ul class="m-0 mt-5 grid w-full list-none gap-2 p-0">
				{
					initial.cloudPoints.map((point, index) => (
						<li class="flex items-start gap-2.5 text-sm">
							<svg class="mt-0.5 size-4 shrink-0 fill-none stroke-lp-ok stroke-[1.75]" viewBox="0 0 16 16" aria-hidden="true">
								<path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span data-i18n={`cloudPoints.${index}`}>{point}</span>
						</li>
					))
				}
			</ul>
			<a
				href={links.cloud}
				data-umami-event="cloud-cta-card"
				class="lp-btn-primary group mt-auto inline-flex h-11 translate-y-0 items-center gap-3 rounded-[.75rem] px-5 text-sm font-semibold tracking-[-.01em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98] max-md:mt-6 md:mt-8">
				<span data-i18n="nav.cloudCta">{initial.nav.cloudCta}</span>
				<ArrowChip />
			</a>
		</article>

		<article class={`${card} border-lp-ink/10`} data-reveal style="--reveal-i: 1">
			<p class="text-sm font-medium text-lp-muted" data-i18n="selfLabel">{initial.selfLabel}</p>
			<h3 class="mt-4 text-2xl leading-[1.15] font-[560] tracking-[-.035em]" data-i18n="selfTitle">
				{initial.selfTitle}
			</h3>
			<p id="self-measure" class="mt-3 text-[.9375rem] leading-[1.55] text-lp-muted" data-i18n="selfBody">
				{initial.selfBody}
			</p>
			<ul
				class="m-0 mt-5 grid w-full list-none gap-px overflow-hidden rounded-[.4rem] p-0"
				style={`grid-template-columns:${containers.map(([, mem]) => `${mem}fr`).join(" ")}`}
				aria-labelledby="self-measure">
				{
					containers.map(([name, mem], index) => (
						<li
							style={`animation-delay:${200 + index * 130}ms`}
							class="hero-segment flex h-[3.5rem] min-w-0 flex-col justify-between bg-lp-ink px-2.5 py-2 font-mono text-[.6875rem] leading-none whitespace-nowrap text-lp-bg">
							<span>{name}</span>
							<span class="text-[.8125rem] tabular-nums">{mem} MB</span>
						</li>
					))
				}
			</ul>
			<div id="install-command" class="mt-4 w-full">
				<div class="flex items-center gap-2 rounded-[.75rem] border border-lp-ink/12 py-1.5 pr-1.5 pl-3.5">
					<code
						class="min-w-0 overflow-x-auto font-mono text-xs whitespace-nowrap [scrollbar-width:none] max-lg:[mask-image:linear-gradient(90deg,#000_calc(100%-1.5rem),transparent)]"
						><span class="text-lp-label select-none">$ </span>{installCommand}</code
					><button
						type="button"
						data-copy-command
						data-umami-event="install-command-copy"
						data-state="idle"
						aria-describedby="copy-status"
						class="ml-auto inline-flex h-8 shrink-0 items-center gap-1.5 rounded-[.5rem] bg-lp-deep px-3 text-xs font-medium transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.96] data-[state=copied]:text-lp-ok">
						<svg class="size-3.5 fill-none stroke-current stroke-[1.5]" viewBox="0 0 16 16" aria-hidden="true">
							<rect x="5.5" y="5.5" width="8" height="8" rx="2"></rect>
							<path d="M10.5 3.5v-.25A1.25 1.25 0 0 0 9.25 2h-6A1.25 1.25 0 0 0 2 3.25v6c0 .69.56 1.25 1.25 1.25h.25"></path>
						</svg>
						<span data-i18n="copy">{initial.copy}</span>
					</button>
				</div>
				<p class="mt-2 text-xs text-lp-muted" data-i18n="heroCommandNote">{initial.heroCommandNote}</p>
				<span id="copy-status" data-copy-status class="sr-only" aria-live="polite"></span>
			</div>
			<ul class="m-0 mt-4 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-[.8125rem] font-medium">
				{initial.trust.map((item, i) => <li data-i18n={`trust.${i}`}>{item}</li>)}
			</ul>
			<p class="mt-1.5 text-xs text-lp-muted" data-i18n="trustNote">{initial.trustNote}</p>
		</article>
	</div>
</section>
