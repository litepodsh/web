---
import { links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
const initial = locales.en;
const shell = "relative";
const core =
	"relative flex h-full flex-col items-start overflow-hidden rounded-2xl border border-lp-ink/10 bg-lp-surface p-6 sm:p-8";
---

<section
	id="self-host"
	class="lp-band py-16 sm:py-20"
	aria-labelledby="operating-paths-title">
	<div class="mb-8" data-reveal>
		<h2
			id="operating-paths-title"
			class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]"
			data-i18n="pathsTitle">
			{initial.pathsTitle}
		</h2>
	</div>

	<div class="grid grid-cols-1 gap-4 sm:grid-cols-[1.25fr_.75fr] sm:gap-5">
		<article id="cloud" class={`${shell} min-w-0`} data-reveal>
			<div class={core}>
				<div class="relative flex w-full flex-wrap items-center justify-between gap-3">
					<p class="text-sm font-medium text-lp-muted" data-i18n="cloudLabel">
						{initial.cloudLabel}
					</p>
					<span
						class="inline-flex items-center gap-1.5 rounded-[.5rem] border border-lp-ok/25 bg-lp-ok/10 px-2 py-1 font-mono text-[.625rem] text-lp-ok">
						<span class="size-1.5 rounded-full bg-lp-ok motion-safe:animate-breathe"></span>
						<span data-i18n="cloudBadge">{initial.cloudBadge}</span>
					</span>
				</div>
				<h3
					class="relative mt-5 text-2xl leading-[1.15] font-[560] tracking-[-.035em]"
					data-i18n="cloudTitle">
					{initial.cloudTitle}
				</h3>
				<p
					class="relative mt-3 max-w-[30rem] text-[.9375rem] leading-[1.55] text-lp-muted"
					data-i18n="cloudBody">
					{initial.cloudBody}
				</p>
				<ul class="relative mt-7 grid w-full max-w-[30rem] gap-2.5">
					{
						initial.cloudPoints.map((point, index) => (
							<li class="lp-groove-b flex items-center gap-3 pb-2.5 text-sm text-lp-ink">
								<span class="lp-raised grid size-5 shrink-0 place-items-center rounded-[.4rem] bg-lp-raised text-lp-accent">
									<svg class="size-3 fill-none stroke-current stroke-2" viewBox="0 0 16 16" aria-hidden="true">
										<path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<span data-i18n={`cloudPoints.${index}`}>{point}</span>
							</li>
						))
					}
				</ul>
				<a
					href={links.cloud}
					data-umami-event="cloud-cta-card"
					class="lp-btn-primary group relative mt-10 inline-flex h-12 items-center gap-3 rounded-[.75rem] px-5 text-[.9375rem] font-semibold tracking-[-.015em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
					<span data-i18n="cloudCta">{initial.cloudCta}</span>
					<ArrowChip />
				</a>
			</div>
		</article>

		<article class={`${shell} min-w-0`} data-reveal style="--reveal-i: 1">
			<div class={core}>
				<h3
					class="relative text-2xl leading-[1.15] font-[560] tracking-[-.035em]"
					data-i18n="selfTitle">
					{initial.selfTitle}
				</h3>
				<p class="mt-3 text-[.9375rem] leading-[1.55] text-lp-muted" data-i18n="selfBody">
					{initial.selfBody}
				</p>
				<a
					href="#install-command"
					class="lp-btn-ink group mt-auto inline-flex h-11 items-center gap-3 rounded-[.75rem] px-5 text-sm font-semibold tracking-[-.01em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98] max-sm:mt-10">
					<span data-i18n="selfCta">{initial.selfCta}</span>
					<ArrowChip direction="down" />
				</a>
			</div>
		</article>
	</div>
</section>
