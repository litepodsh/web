---
import { installCommand, links, locales } from '../data/landing.mjs';
const initial = locales.en;
const card = 'rounded-[1.8125rem] border border-lp-ink/15 bg-lp-deep p-2.5 shadow-[inset_0_1px_0_rgba(255,255,255,.12),0_1.25rem_3.5rem_rgba(17,33,23,.12)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.05),0_1.25rem_3.5rem_rgba(1,10,3,.28)]';
const core = 'm-0 flex w-full min-h-[16.5rem] flex-col items-start rounded-[1.25rem] bg-lp-surface p-7 shadow-[inset_0_1px_0_rgba(255,255,255,.35)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.05)]';
---
<section id="self-host" class="mt-14 grid grid-cols-1 gap-3 sm:mt-[4.5rem] sm:grid-cols-[1.4fr_.6fr]"><article class={`${card} motion-safe:animate-reveal`}><div class={core}><p class="font-mono text-[.6875rem] font-bold uppercase tracking-[.09em] text-lp-acid" data-i18n="selfLabel">{initial.selfLabel}</p><h2 class="my-auto max-w-[9ch] text-[clamp(2.25rem,4vw,3.5rem)] font-[540] leading-[.88] tracking-[-.08em]" data-i18n="selfTitle">{initial.selfTitle}</h2><div id="install-command" class="w-full"><div class="flex items-center gap-2 rounded-[.875rem] border border-lp-acid/35 bg-lp-bg py-1.5 pr-1.5 pl-3"><code class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap font-mono text-xs font-semibold text-lp-acid dark:text-[#dfffa0]">$ {installCommand}</code><button type="button" data-copy-command data-state="idle" aria-describedby="copy-status" class="ml-auto rounded-lg bg-lp-acid px-2.5 py-2 text-[.6875rem] font-extrabold text-[#0b120d]"><span data-i18n="copy">{initial.copy}</span></button></div><p class="mt-2 text-[.6875rem] font-medium text-lp-muted" data-i18n="commandNote">{initial.commandNote}</p><p id="copy-status" data-copy-status aria-live="polite" class="mt-1 min-h-[1em] text-[.6875rem] font-semibold text-lp-acid"></p></div><a href="#install-command" data-i18n="selfCta" class="mt-4 rounded-full bg-lp-acid px-3.5 py-2.5 text-xs font-extrabold text-[#0b120d]">{initial.selfCta}</a></div></article><article class={card}><div class={core}><p class="font-mono text-[.6875rem] font-bold uppercase tracking-[.09em] text-lp-acid" data-i18n="cloudLabel">{initial.cloudLabel}</p><h2 class="my-auto max-w-[9ch] text-[clamp(2.25rem,4vw,3.5rem)] font-[540] leading-[.88] tracking-[-.08em]" data-i18n="cloudTitle">{initial.cloudTitle}</h2><div class="w-full"><p class="rounded-[.875rem] border border-lp-ink/15 bg-lp-bg px-3 py-3 font-mono text-xs font-semibold text-lp-muted" data-i18n="cloudPrice">{initial.cloudPrice}</p></div><a href={links.cloud} target="_blank" rel="noreferrer" data-i18n="cloudCta" class="mt-4 rounded-full bg-lp-ink px-3.5 py-2.5 text-xs font-extrabold text-lp-surface">{initial.cloudCta}</a></div></article></section>
