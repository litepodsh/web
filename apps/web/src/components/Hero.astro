---
import { links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
import HeroWire from "./HeroWire.astro";
const initial = locales.en;
---

<section
	id="top"
	class="hero-field relative z-10 -mt-16 bg-lp-accent pt-24 text-lp-accent-ink sm:pt-32"
	aria-labelledby="hero-title">
	<div class="mx-auto w-[calc(100%-2rem)] max-w-[72rem] sm:w-[calc(100%-3rem)]">
		<h1
			id="hero-title"
			data-i18n="heroTitle"
			class="text-[clamp(2.75rem,6.4vw,5.5rem)] leading-[1] font-[560] tracking-[-.04em] whitespace-pre-line hero-title">{initial.heroTitle}</h1>
		<p class="hero-in mt-6 max-w-[42ch] text-[clamp(1.125rem,1.6vw,1.3125rem)] leading-[1.4]" style="--d:280ms" data-i18n="heroSub">
			{initial.heroSub}
		</p>
		<div class="hero-in mt-8 flex flex-wrap items-center gap-3" style="--d:380ms">
			<a
				href={links.cloud}
				data-umami-event="cloud-cta-hero"
				class="group inline-flex h-12 items-center gap-3 rounded-[.75rem] bg-lp-accent-ink px-5 text-[.9375rem] font-semibold tracking-[-.015em] text-lp-accent transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
				<span data-i18n="nav.cloudCta">{initial.nav.cloudCta}</span>
				<ArrowChip />
			</a>
			<a
				href="#self-host"
				data-umami-event="self-host-cta-hero"
				class="inline-flex h-12 items-center rounded-[.75rem] border-[1.5px] border-lp-accent-ink px-5 text-[.9375rem] font-semibold tracking-[-.015em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]"
				data-i18n="heroSelfAlt">
				{initial.heroSelfAlt}
			</a>
		</div>
		<p class="hero-in mt-4 text-xs" style="--d:470ms" data-i18n="heroTaxNote">{initial.heroTaxNote}</p>
	</div>
	<HeroWire />
</section>
