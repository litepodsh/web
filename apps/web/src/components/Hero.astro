---
import { installCommand, links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
const initial = locales.en;

const containers = [
	["litepod-caddy", "2.24%", "24.7MB"],
	["litepod-dragonfly", "3.94%", "21.82MB"],
	["litepod-api", "1.77%", "16.21MB"],
];
---

<section
	class="relative grid lg:min-h-[min(calc(100dvh-6rem),52rem)] grid-cols-1 items-center gap-14 pt-10 pb-16 sm:pt-16 lg:grid-cols-[1.12fr_.88fr] lg:gap-10 lg:pt-12"
	aria-labelledby="hero-title">
	<div class="min-w-0 motion-safe:animate-reveal">
		<p
			class="lp-raised inline-flex items-center gap-2 rounded-full border border-lp-ink/8 bg-lp-raised py-1 pr-3 pl-1.5 font-mono text-[.6875rem] text-lp-label">
			<span class="grid size-4 place-items-center rounded-full bg-lp-accent/14">
				<span class="size-1.5 rounded-full bg-lp-accent motion-safe:animate-breathe"></span>
			</span>
			<span data-i18n="eyebrow">{initial.eyebrow}</span>
		</p>
		<h1
			id="hero-title"
			class="mt-7 text-[clamp(2.5rem,6.4vw,5.5rem)] leading-[.95] font-[560] tracking-[-.065em]">
			<span class="sr-only" data-hero-accessible>{initial.heroAccessible}</span>
			<span aria-hidden="true">
				<span data-i18n="heroLead">{initial.heroLead}</span><br />
				<span class="hero-reel w-full" data-hero-reel>
					<span class="hero-reel__word" data-hero-word>{initial.heroTerms[0]}</span>
				</span><br />
				<span class="text-lp-muted" data-i18n="heroClose">{initial.heroClose}</span>
			</span>
		</h1>
		<p
			class="mt-7 max-w-[34rem] text-[1.0625rem] leading-[1.6] text-lp-muted"
			data-i18n="intro">
			{initial.intro}
		</p>

		<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
			<a
				href={links.cloud}
				data-umami-event="cloud-cta-hero"
				class="lp-btn-primary group inline-flex h-12 items-center gap-3 rounded-full pr-2 pl-6 text-[.9375rem] font-semibold tracking-[-.015em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
				<span data-i18n="heroCloudCta">{initial.heroCloudCta}</span>
				<ArrowChip class="size-8 bg-black/12" />
			</a>
			<a
				href="#install-command"
				class="group inline-flex items-center gap-2 text-sm font-medium text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink">
				<span data-i18n="heroSelfCta">{initial.heroSelfCta}</span>
				<ArrowChip direction="down" class="size-6 bg-lp-ink/8" />
			</a>
		</div>

		<div id="install-command" class="mt-10 max-w-[33rem]">
			<div
				class="lp-well flex items-center gap-2 rounded-[1.125rem] border border-lp-ink/8 bg-lp-deep py-1.5 pr-1.5 pl-4">
				<code
					class="min-w-0 overflow-x-auto font-mono text-xs whitespace-nowrap text-lp-ink [scrollbar-width:none]"
					><span class="text-lp-label select-none">$ </span>{installCommand}</code
				><button
					type="button"
					data-copy-command
					data-state="idle"
					aria-describedby="copy-status"
					class="lp-raised ml-auto inline-flex h-8 shrink-0 items-center gap-1.5 rounded-full bg-lp-raised px-3 text-xs font-medium text-lp-ink transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.96] data-[state=copied]:text-lp-ok">
					<svg class="size-3.5 fill-none stroke-current stroke-[1.5]" viewBox="0 0 16 16" aria-hidden="true">
						<rect x="5.5" y="5.5" width="8" height="8" rx="2"></rect>
						<path d="M10.5 3.5v-.25A1.25 1.25 0 0 0 9.25 2h-6A1.25 1.25 0 0 0 2 3.25v6c0 .69.56 1.25 1.25 1.25h.25"></path>
					</svg>
					<span data-i18n="copy">{initial.copy}</span>
				</button>
			</div>
			<p class="mt-2.5 pl-4 text-xs text-lp-muted" data-i18n="heroCommandNote">
				{initial.heroCommandNote}
			</p>
			<span id="copy-status" data-copy-status class="sr-only" aria-live="polite"></span>
		</div>
	</div>

	<figure
		class="lp-float relative m-0 min-w-0 rounded-[2rem] border border-lp-ink/10 bg-lp-deep p-2.5 motion-safe:animate-reveal [animation-delay:180ms] lg:rotate-[1.5deg] lg:transition-transform lg:duration-700 lg:ease-lp lg:hover:rotate-0">
		<div class="lp-inset overflow-hidden rounded-[1.5rem] border border-lp-ink/10 bg-lp-terminal">
			<div class="flex items-center gap-1.5 border-b border-white/6 px-4 py-3">
				<span class="size-2.5 rounded-full bg-[#f06a48]/80"></span>
				<span class="size-2.5 rounded-full bg-[#d9a441]/70"></span>
				<span class="size-2.5 rounded-full bg-[#5fbf8f]/70"></span>
				<span class="ml-3 font-mono text-[.625rem] text-[#b7c0b8]/70">root@litepod — ssh</span>
			</div>
			<div class="overflow-x-auto p-5 [scrollbar-width:thin]">
				<figcaption
					class="mb-4 max-w-[34ch] font-mono text-[.6875rem] leading-relaxed text-[#b7c0b8]"
					data-i18n="statsNote">
					{initial.statsNote}
				</figcaption>
				<pre class="min-w-[30rem] font-mono text-[.6875rem] leading-6 text-lp-terminal-ink"><code><span class="text-[#f06a48]">root@litepod:~#</span> podman stats --no-stream
<span class="text-[#b7c0b8]/70">NAME                CPU %     MEM USAGE / LIMIT    BLOCK IO</span>
litepod-caddy       2.24%     24.7MB / 16.7GB      0B / 0B
litepod-dragonfly   3.94%     21.82MB / 16.7GB     0B / 0B
litepod-api         1.77%     16.21MB / 16.7GB     0B / 0B</code></pre>
			</div>
			<div class="grid grid-cols-3 border-t border-white/6">
				{
					containers.map(([name, cpu, mem]) => (
						<div class="border-white/6 px-4 py-3.5 [&+div]:border-l">
							<p class="flex items-center gap-1.5 font-mono text-[.625rem] text-[#b7c0b8]">
								<span class="size-1.5 rounded-full bg-[#5fbf8f] motion-safe:animate-breathe" />
								{name.replace("litepod-", "")}
							</p>
							<p class="mt-1.5 font-mono text-sm text-[#f2f0e9] tabular-nums">{mem}</p>
							<p class="font-mono text-[.625rem] text-[#b7c0b8]/60 tabular-nums">cpu {cpu}</p>
						</div>
					))
				}
			</div>
		</div>
		<p
			class="px-3 pt-3 pb-1 font-mono text-[.6875rem] text-lp-label"
			data-i18n="statsTotal">
			{initial.statsTotal}
		</p>
	</figure>
</section>
