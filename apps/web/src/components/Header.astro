---
import { links } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
import LitepodMark from "./LitepodMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	/** The EN/ES switch is driven by LandingControls, so pages without it hide the switch. */
	languageSwitch?: boolean;
}
const { languageSwitch = true } = Astro.props;

const navLinks = [
	["templates", links.templates, "Templates"],
	["docs", links.docs, "Docs"],
	["demo", links.demo, "Demo"],
	["github", links.github, "GitHub"],
];
---

<header data-site-header class="site-header sticky top-0 z-30 border-b border-lp-ink/10 bg-lp-bg/70 backdrop-blur-xl backdrop-saturate-150">
	<nav
		aria-label="Primary navigation"
		class="mx-auto flex h-16 w-[calc(100%-2rem)] max-w-[72rem] items-center gap-2 sm:w-[calc(100%-3rem)] sm:gap-3">
		<a
			class="inline-flex items-center gap-2 text-sm font-semibold tracking-[-.04em]"
			href="/#top">
			<LitepodMark class="size-7" />
			<span>litepod</span>
		</a>

		<div
			class="ml-4 hidden items-center gap-0.5 md:flex">
			{
				navLinks.map(([key, href, label]) => (
					<a
						href={href}
						target="_blank"
						rel="noreferrer"
						data-i18n={`nav.${key}`}
						class="rounded-[.5rem] px-3 py-1.5 text-sm font-medium text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink">
						{label}
					</a>
				))
			}
		</div>

		<div class="ml-auto flex items-center gap-1.5 sm:gap-2">
			{languageSwitch && (
				<>
			<div
				role="group"
				aria-label="Language"
				data-language-switch
				class="lp-inset relative isolate hidden h-8 w-[4.75rem] rounded-full bg-lp-deep p-0.5 sm:flex">
				<span
					aria-hidden="true"
					data-language-indicator
					class="lp-raised absolute inset-y-0.5 start-0.5 -z-10 w-[calc((100%-.25rem)/2)] rounded-full bg-lp-raised transition-transform duration-[450ms] ease-spring"
				></span>
				<button
					type="button"
					data-lang="en"
					aria-pressed="true"
					class="flex-1 rounded-full font-mono text-[.6875rem] text-lp-ink transition-[color,transform] duration-300 ease-lp active:scale-[.96] aria-[pressed=false]:text-lp-muted">
					EN
				</button>
				<button
					type="button"
					data-lang="es"
					aria-pressed="false"
					class="flex-1 rounded-full font-mono text-[.6875rem] text-lp-ink transition-[color,transform] duration-300 ease-lp active:scale-[.96] aria-[pressed=false]:text-lp-muted">
					ES
				</button>
			</div>
			<button
				type="button"
				data-language-toggle
				class="lp-raised grid h-8 place-items-center rounded-full bg-lp-raised px-2.5 font-mono text-[.6875rem] text-lp-muted active:scale-[.96] sm:hidden"
				aria-label="ES, cambiar a español">
				ES
			</button>
				</>
			)}
			<ThemeToggle />
			<a
				href="/#self-host"
				data-i18n="nav.selfHost"
				class="hidden rounded-[.5rem] px-3 py-2 text-sm font-medium text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink lg:inline-flex">
				Self-host
			</a>
			<a
				href="/pricing"
				data-i18n="nav.pricing"
				class="hidden rounded-[.5rem] px-3 py-2 text-sm font-medium text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink sm:inline-flex">
				Pricing
			</a>
			<a
				href={links.cloud}
				data-umami-event="cloud-cta-header"
				class="lp-btn-primary group inline-flex h-9 items-center gap-2 rounded-[.5625rem] px-3.5 text-[.8125rem] font-semibold tracking-[-.01em] transition-transform duration-300 ease-lp active:scale-[.98]">
				<span data-i18n="nav.cloudCta">Try Cloud</span>
				<ArrowChip />
			</a>
		</div>
	</nav>
</header>

<script>
	// Over the hero field the header is transparent and takes the field's ink.
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const field = document.querySelector("section#top.hero-field");
	if (header && field) {
		header.dataset.overField = "";
		new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting) header.dataset.overField = "";
				else delete header.dataset.overField;
			},
			{ rootMargin: "-64px 0px 0px 0px" },
		).observe(field);
		const syncScrolled = () => {
			if (window.scrollY > 4) header.dataset.scrolled = "";
			else delete header.dataset.scrolled;
		};
		addEventListener("scroll", syncScrolled, { passive: true });
		syncScrolled();
	}
</script>
