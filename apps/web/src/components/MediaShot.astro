---
import { Image } from "astro:assets";
import appsDark from "../assets/screenshots/apps-dark.webp";
import appsLight from "../assets/screenshots/apps-light.webp";
import shellDark from "../assets/screenshots/shell-dark.webp";
import shellLight from "../assets/screenshots/shell-light.webp";
import templatesDark from "../assets/screenshots/templates-dark.webp";
import templatesLight from "../assets/screenshots/templates-light.webp";
import volumeDark from "../assets/screenshots/volume-dark.webp";
import volumeLight from "../assets/screenshots/volume-light.webp";

interface Props {
	variant: "apps" | "volume" | "shell" | "templates";
	caption: string;
	priority?: boolean;
}
const { variant, caption, priority = false } = Astro.props;

const shots = {
	apps: { light: appsLight, dark: appsDark },
	volume: { light: volumeLight, dark: volumeDark },
	shell: { light: shellLight, dark: shellDark },
	templates: { light: templatesLight, dark: templatesDark },
};
const shot = shots[variant];
const singleTone = shot.light === shot.dark;
const frame = "size-full object-cover object-left-top";
const loading = priority ? "eager" : "lazy";
---

<figure
	class="relative m-0 h-full min-h-0 overflow-hidden rounded-[1.25rem] border border-lp-ink/12 bg-lp-surface shadow-[inset_0_1px_0_rgba(255,255,255,.5)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.04)]"
	aria-label={caption}>
	<figcaption class="sr-only">{caption}</figcaption>
	{singleTone ? (
			<Image src={shot.dark} alt="" loading={loading} class={frame} />
		) : (
			<>
				<Image
					src={shot.light}
					alt=""
					loading={loading}
					class={`${frame} dark:hidden`}
				/>
				<Image
					src={shot.dark}
					alt=""
					loading={loading}
					class={`${frame} hidden dark:block`}
				/>
			</>
		)}
</figure>
