---
import { Image } from "astro:assets";
import homeDark from "../assets/screenshots/home-dark.webp";
import homeLight from "../assets/screenshots/home-light.webp";
import overviewDark from "../assets/screenshots/overview-dark.webp";
import overviewLight from "../assets/screenshots/overview-light.webp";
import deploymentsDark from "../assets/screenshots/deployments-dark.webp";
import deploymentsLight from "../assets/screenshots/deployments-light.webp";
import analyticsDark from "../assets/screenshots/analytics-dark.webp";
import analyticsLight from "../assets/screenshots/analytics-light.webp";
import metricsDark from "../assets/screenshots/metrics-dark.webp";
import metricsLight from "../assets/screenshots/metrics-light.webp";
import terminalDark from "../assets/screenshots/terminal-dark.webp";
import terminalLight from "../assets/screenshots/terminal-light.webp";
import volumesDark from "../assets/screenshots/volumes-dark.webp";
import volumesLight from "../assets/screenshots/volumes-light.webp";
import fleetDark from "../assets/screenshots/fleet-dark.webp";
import fleetLight from "../assets/screenshots/fleet-light.webp";
import templatesDark from "../assets/screenshots/templates-dark.webp";
import templatesLight from "../assets/screenshots/templates-light.webp";

interface Props {
	variant: "home" | "overview" | "deployments" | "analytics" | "metrics" | "terminal" | "volumes" | "fleet" | "templates";
	caption: string;
	priority?: boolean;
}
const { variant, caption, priority = false } = Astro.props;

const shots = {
	home: { light: homeLight, dark: homeDark },
	overview: { light: overviewLight, dark: overviewDark },
	deployments: { light: deploymentsLight, dark: deploymentsDark },
	analytics: { light: analyticsLight, dark: analyticsDark },
	metrics: { light: metricsLight, dark: metricsDark },
	terminal: { light: terminalLight, dark: terminalDark },
	volumes: { light: volumesLight, dark: volumesDark },
	fleet: { light: fleetLight, dark: fleetDark },
	templates: { light: templatesLight, dark: templatesDark },
};
const shot = shots[variant];
const singleTone = shot.light === shot.dark;
const frame = "size-full object-cover object-left-top";
const loading = priority ? "eager" : "lazy";
// Shots render at most ~70rem wide; let the browser pick a smaller file on phones.
const responsive = { widths: [480, 768, 1080, 1440, 1800], sizes: "(min-width: 72rem) 70rem, calc(100vw - 2rem)" };
---

<figure
	class="lp-raised relative m-0 h-full min-h-0 overflow-hidden rounded-[1.5rem] border border-lp-ink/10 bg-lp-surface"
	aria-label={caption}>
	<figcaption class="sr-only">{caption}</figcaption>
	{singleTone ? (
			<Image src={shot.dark} alt={`Litepod self-hosted PaaS panel: ${caption}`} loading={loading} class={frame} {...responsive} />
		) : (
			<>
				<Image
					src={shot.light}
					alt={`Litepod self-hosted PaaS panel: ${caption}`}
					loading={loading}
					{...responsive}
					class={`${frame} dark:hidden`}
				/>
				<Image
					src={shot.dark}
					alt={`Litepod self-hosted PaaS panel: ${caption}`}
					loading={loading}
					{...responsive}
					class={`${frame} hidden dark:block`}
				/>
			</>
		)}
</figure>
