---
import { links, locales } from "../data/landing.mjs";
import ArrowChip from "./ArrowChip.astro";
const initial = locales.en;
---

<section
	class="grid gap-8 py-16 sm:py-20 md:grid-cols-[1fr_auto] md:items-end md:gap-14"
	aria-labelledby="demo-band-title"
	data-reveal>
	<div>
		<h2
			id="demo-band-title"
			class="text-[clamp(2rem,3.4vw,2.75rem)] leading-[1.05] font-[560] tracking-[-.04em]"
			data-i18n="demoTitle">
			{initial.demoTitle}
		</h2>
		<p class="mt-4 max-w-[36rem] leading-[1.55] text-lp-muted" data-i18n="demoBody">
			{initial.demoBody}
		</p>
		<p class="mt-3 text-sm text-lp-muted" data-i18n="demoHint">{initial.demoHint}</p>
	</div>
	<div class="flex flex-col items-start gap-4 md:items-end">
		<a
			href={links.demo}
			target="_blank"
			rel="noreferrer"
			data-umami-event="demo-cta-band"
			class="lp-btn-primary group inline-flex h-12 items-center gap-3 rounded-[.75rem] px-5 text-[.9375rem] font-semibold tracking-[-.015em] transition-transform duration-300 ease-lp hover:-translate-y-px active:scale-[.98]">
			<span data-i18n="demoCta">{initial.demoCta}</span>
			<ArrowChip />
		</a>
		<a
			href={links.docs}
			target="_blank"
			rel="noreferrer"
			class="group inline-flex items-center gap-2 text-sm font-medium text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink">
			<span data-i18n="demoSecondary">{initial.demoSecondary}</span>
			<ArrowChip />
		</a>
	</div>
</section>
