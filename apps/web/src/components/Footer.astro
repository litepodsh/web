---
import { comparePages, links } from "../data/landing.mjs";
import LitepodMark from "./LitepodMark.astro";

const product = [
	["nav.cloud", links.cloud, "Cloud", false],
	["nav.templates", links.templates, "Templates", true],
	["nav.docs", links.docs, "Docs", true],
	["nav.demo", links.demo, "Demo", true],
	["nav.github", links.github, "GitHub", true],
];
const legal = [
	["/about", "About"],
	["/terms", "Terms"],
	["/privacy", "Privacy"],
	["/refunds", "Refunds"],
];
const link =
	"py-1 text-sm text-lp-muted transition-colors duration-300 ease-lp hover:text-lp-ink";
---

<footer
	class="relative z-10 mx-auto w-[calc(100%-2rem)] max-w-[72rem] pb-10 sm:w-[calc(100%-3rem)]">
	<div class="lp-groove-t grid gap-8 pt-8 md:grid-cols-[1fr_auto_auto_auto] md:items-start md:gap-16">
		<div>
			<a
				href="/#top"
				class="inline-flex w-fit items-center gap-2 text-sm font-semibold tracking-[-.04em]">
				<LitepodMark class="size-6" />
				<span>litepod</span>
			</a>
			<p class="mt-3 font-mono text-[.6875rem] text-lp-muted">
				© {new Date().getFullYear()} Litepod Studio
			</p>
			<p class="mt-1 font-mono text-[.6875rem] text-lp-muted" data-i18n="openSource">
				Open source soon · Apache 2.0
			</p>
		</div>
		<nav aria-label="Product" class="grid gap-1">
			{
				product.map(([key, href, label, external]) => (
					<a
						href={href}
						data-i18n={key}
						class={link}
						{...(external ? { target: "_blank", rel: "noreferrer" } : {})}>
						{label}
					</a>
				))
			}
		</nav>
		<nav aria-label="Compare" class="grid gap-1">
			{comparePages.map(([href, label]) => <a href={href} class={link}>{label}</a>)}
		</nav>
		<nav aria-label="Company" class="grid gap-1">
			{legal.map(([href, label]) => <a href={href} class={link}>{label}</a>)}
		</nav>
	</div>
</footer>
