---
// Trailing icon for signature CTAs, in its own circular inset (the console's
// CustomButton). The parent needs the `group` class for the hover nudge.
interface Props {
	class?: string;
	direction?: "up-right" | "down";
}
const { class: className = "bg-black/10", direction = "up-right" } = Astro.props;
---

<span
	aria-hidden="true"
	class={`grid size-7 shrink-0 place-items-center rounded-full transition-transform duration-300 ease-lp group-hover:scale-105 ${direction === "down" ? "group-hover:translate-y-0.5" : "group-hover:translate-x-0.5 group-hover:-translate-y-px"} ${className}`}>
	{
		direction === "down" ? (
			<svg class="size-3.5 fill-none stroke-current stroke-[1.5]" viewBox="0 0 16 16">
				<path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		) : (
			<svg class="size-3.5 fill-none stroke-current stroke-[1.5]" viewBox="0 0 16 16">
				<path d="M5 11 11 5M5.5 5H11v5.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		)
	}
</span>
