---
import {
	benefits,
	installCommand,
	locales,
	mediaSlots,
} from "../data/landing.mjs";
---

<script define:vars={{ locales, benefits, mediaSlots, installCommand }}>
const LOCALE_COOKIE = "litepod-locale";
const readLocaleCookie = () => {
	const match = document.cookie.match(new RegExp(`(?:^|; )${LOCALE_COOKIE}=(en|es)`));
	return match?.[1] === "es" ? "es" : "en";
};
const writeLocaleCookie = (next) => {
	document.cookie = `${LOCALE_COOKIE}=${next}; max-age=31536000; path=/; SameSite=Lax`;
};
let locale = readLocaleCookie();
let mediaIndex = 0;
const languageToggle = document.querySelector("[data-language-toggle]");
const languageButtons = document.querySelectorAll("[data-lang]");
const languageIndicator = document.querySelector("[data-language-indicator]");
const copyButton = document.querySelector("[data-copy-command]");
const copyStatus = document.querySelector("[data-copy-status]");
const capsule = document.querySelector("[data-capsule]");
const capsuleIndicator = document.querySelector("[data-capsule-indicator]");
const mediaTabs = [...document.querySelectorAll("[data-media-tab]")];
const mediaPanels = [...document.querySelectorAll("[data-media-panel]")];
const mediaCaption = document.querySelector("[data-media-caption]");
const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const message = (key) =>
	key.split(".").reduce((value, part) => value?.[part], locales[locale]);
const setBenefits = () =>
	document.querySelectorAll("[data-benefit-index]").forEach((node) => {
		const [title, body] = benefits[locale][Number(node.dataset.benefitIndex)];
		node.querySelector("[data-title]").textContent = title;
		node.querySelector("[data-body]").textContent = body;
	});
const setMedia = () => {
	document.querySelectorAll("[data-media-index]").forEach((node) => {
		const figure = node.querySelector("figure");
		const caption = mediaSlots[locale][Number(node.dataset.mediaIndex)][1];
		figure.setAttribute("aria-label", caption);
		figure.querySelector("figcaption").textContent = caption;
	});
	mediaTabs.forEach((tab) => {
		tab.textContent = mediaSlots[locale][Number(tab.dataset.mediaTab)][1].split(" / ")[0];
	});
	if (mediaCaption) mediaCaption.textContent = mediaSlots[locale][mediaIndex][1];
	moveCapsule();
};

// Capsule tabs: the raised indicator springs to the selected tab.
const moveCapsule = (animate = true) => {
	const on = mediaTabs[mediaIndex];
	if (!on || !capsuleIndicator) return;
	capsuleIndicator.style.transition = animate
		? "transform .45s cubic-bezier(.3,1.25,.4,1), width .45s cubic-bezier(.3,1.25,.4,1), opacity .2s"
		: "none";
	capsuleIndicator.style.width = `${on.offsetWidth}px`;
	capsuleIndicator.style.transform = `translateX(${on.offsetLeft}px)`;
	capsuleIndicator.style.opacity = "1";
};
// Gallery slider: the new screen slides in from the side of the tab you picked while
// the old one slides out the other way; screens in between never cross the frame.
const slideEase = "transform .75s cubic-bezier(.32,.72,0,1)";
const selectMedia = (next, focus = false) => {
	const previous = mediaIndex;
	mediaIndex = next;
	mediaTabs.forEach((tab, index) => {
		const selected = index === next;
		tab.setAttribute("aria-selected", String(selected));
		tab.tabIndex = selected ? 0 : -1;
		if (selected && focus) tab.focus();
	});
	const incoming = mediaPanels[next];
	const outgoing = mediaPanels[previous];
	const direction = next > previous ? 1 : -1;
	mediaPanels.forEach((panel, index) => {
		const current = index === next;
		panel.classList.toggle("pointer-events-none", !current);
		panel.toggleAttribute("inert", !current);
		if (!current && panel !== outgoing) {
			panel.style.transition = "none";
			panel.classList.add("invisible");
		}
	});
	if (next !== previous && incoming && outgoing && !reducedMotion) {
		incoming.style.transition = "none";
		incoming.style.transform = `translateX(${direction * 100}%)`;
		incoming.classList.remove("invisible");
		incoming.getBoundingClientRect();
		incoming.style.transition = slideEase;
		outgoing.style.transition = slideEase;
		incoming.style.transform = "translateX(0)";
		outgoing.style.transform = `translateX(${-direction * 100}%)`;
		outgoing.addEventListener(
			"transitionend",
			() => {
				if (mediaPanels.indexOf(outgoing) !== mediaIndex) outgoing.classList.add("invisible");
			},
			{ once: true },
		);
	} else if (incoming) {
		incoming.style.transform = "translateX(0)";
		incoming.classList.remove("invisible");
		if (outgoing && outgoing !== incoming) outgoing.classList.add("invisible");
	}
	if (mediaCaption) mediaCaption.textContent = mediaSlots[locale][next][1];
	moveCapsule();
};
// Swipe between screens on touch and pen.
const mediaTrack = document.querySelector("[data-media-track]");
let swipeStart = null;
mediaTrack?.addEventListener("pointerdown", (event) => {
	if (event.pointerType !== "mouse") swipeStart = [event.clientX, event.clientY];
});
mediaTrack?.addEventListener("pointerup", (event) => {
	if (!swipeStart) return;
	const dx = event.clientX - swipeStart[0];
	const dy = event.clientY - swipeStart[1];
	swipeStart = null;
	if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
	const next = Math.min(mediaTabs.length - 1, Math.max(0, mediaIndex + (dx < 0 ? 1 : -1)));
	if (next !== mediaIndex) selectMedia(next);
});
mediaTrack?.addEventListener("pointercancel", () => {
	swipeStart = null;
});
mediaTabs.forEach((tab, index) => {
	tab.addEventListener("click", () => selectMedia(index));
	tab.addEventListener("keydown", (event) => {
		const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
		if (!step) return;
		event.preventDefault();
		selectMedia((index + step + mediaTabs.length) % mediaTabs.length, true);
	});
});
mediaPanels.slice(1).forEach((panel) => panel.setAttribute("inert", ""));
if (capsule && "ResizeObserver" in window)
	new ResizeObserver(() => moveCapsule(false)).observe(capsule);
moveCapsule(false);

const applyLocale = () => {
	document.documentElement.lang = locale;
	const other = locale === "en" ? "es" : "en";
	if (languageToggle) {
		languageToggle.textContent = other.toUpperCase();
		languageToggle.setAttribute(
			"aria-label",
			locale === "en" ? "ES, cambiar a español" : "EN, switch to English",
		);
	}
	languageButtons.forEach((button) =>
		button.setAttribute("aria-pressed", String(button.dataset.lang === locale)),
	);
	if (languageIndicator)
		languageIndicator.style.transform = `translateX(${locale === "en" ? 0 : 100}%)`;
	document.querySelectorAll("[data-i18n]").forEach((node) => {
		const value = message(node.dataset.i18n);
		if (typeof value === "string") node.textContent = value;
	});
	setBenefits();
	setMedia();
	window.dispatchEvent(new CustomEvent("litepod:locale", { detail: locale }));
};
languageToggle?.addEventListener("click", () => {
	locale = locale === "en" ? "es" : "en";
	writeLocaleCookie(locale);
	applyLocale();
});
languageButtons.forEach((button) =>
	button.addEventListener("click", () => {
		if (button.dataset.lang === locale) return;
		locale = button.dataset.lang;
		writeLocaleCookie(locale);
		applyLocale();
	}),
);
// The page ships in English; a returning Spanish visitor gets the swap on load.
if (locale !== "en") applyLocale();

// Scroll reveal: one observer, each element unobserved once it has entered.
if ("IntersectionObserver" in window) {
	const observer = new IntersectionObserver(
		(entries) =>
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add("is-in");
				observer.unobserve(entry.target);
			}),
		{ rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
	);
	document.querySelectorAll("[data-reveal]").forEach((node) => observer.observe(node));
} else {
	document.querySelectorAll("[data-reveal]").forEach((node) => node.classList.add("is-in"));
}

copyButton?.addEventListener("click", async () => {
	const label = copyButton.querySelector("[data-i18n='copy']");
	try {
		await navigator.clipboard.writeText(installCommand);
		copyButton.dataset.state = "copied";
		label.textContent = locales[locale].copied;
		if (copyStatus) copyStatus.textContent = locales[locale].copied;
	} catch {
		if (copyStatus) copyStatus.textContent = locales[locale].copyUnavailable;
	}
	window.setTimeout(() => {
		copyButton.dataset.state = "idle";
		label.textContent = locales[locale].copy;
	}, 1800);
});
</script>
