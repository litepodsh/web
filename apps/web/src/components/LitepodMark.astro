---
// Ported from the console (litepod-mark.svelte): the favicon's rounded square
// with the pill cut out and filled by a halftone that fades to the corner.
interface Props {
	class?: string;
}
const { class: className = "size-7" } = Astro.props;
const uid = `lpm-${Math.random().toString(36).slice(2, 8)}`;
const pill = {
	x: 34,
	y: 42,
	width: 52,
	height: 36,
	rx: 18,
	transform: "rotate(-24 60 60)",
};
---

<svg
	class={`litepod-mark block text-lp-accent ${className}`}
	viewBox="0 0 120 120"
	role="img"
	aria-label="Litepod">
	<defs>
		<pattern
			id={`${uid}-ht`}
			width="7"
			height="7"
			patternUnits="userSpaceOnUse"
			patternTransform="rotate(-24 60 60)">
			<circle cx="3.5" cy="3.5" r="2.1" fill="currentColor"></circle>
		</pattern>
		<linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#fff"></stop>
			<stop offset=".85" stop-color="#fff" stop-opacity=".15"></stop>
		</linearGradient>
		<mask id={`${uid}-fade-mask`}>
			<rect width="120" height="120" fill={`url(#${uid}-fade)`}></rect>
		</mask>
		<mask
			id={`${uid}-cut`}
			maskUnits="userSpaceOnUse"
			x="0"
			y="0"
			width="120"
			height="120">
			<rect x="10" y="10" width="100" height="100" rx="26" fill="#fff"></rect>
			<rect {...pill} fill="#000"></rect>
		</mask>
		<clipPath id={`${uid}-pill`}><rect {...pill}></rect></clipPath>
	</defs>
	<rect
		x="10"
		y="10"
		width="100"
		height="100"
		rx="26"
		fill="currentColor"
		mask={`url(#${uid}-cut)`}></rect>
	<g class="halftone" clip-path={`url(#${uid}-pill)`} opacity=".75">
		<g mask={`url(#${uid}-fade-mask)`}>
			<rect width="120" height="120" fill={`url(#${uid}-ht)`}></rect>
		</g>
	</g>
</svg>
