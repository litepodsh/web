<button
	type="button"
	data-theme-toggle
	aria-label="Switch to light theme"
	class="grid size-8 place-items-center rounded-full bg-lp-ink/8 text-lp-ink transition-transform duration-500 [transition-timing-function:cubic-bezier(.32,.72,0,1)] active:scale-[.98]">
	<svg
		data-theme-sun
		class="size-4 fill-none stroke-current stroke-[1.5]"
		viewBox="0 0 16 16"
		aria-hidden="true">
		<circle cx="8" cy="8" r="3"></circle>
		<path
			d="M8 1.5v1.25M8 13.25v1.25M14.5 8h-1.25M2.75 8H1.5M12.6 3.4l-.9.9M4.3 11.7l-.9.9M12.6 12.6l-.9-.9M4.3 4.3l-.9-.9"></path>
	</svg><svg
		data-theme-moon
		class="hidden size-4 fill-none stroke-current stroke-[1.5]"
		viewBox="0 0 16 16"
		aria-hidden="true">
		<path d="M13.6 10.2A5.7 5.7 0 0 1 5.8 2.4 5.7 5.7 0 1 0 13.6 10.2Z"></path>
	</svg>
</button>
<script>
const themeButton = document.querySelector("[data-theme-toggle]");
const updateIcon = () => {
	const dark = document.documentElement.classList.contains("dark");
	document.querySelector("[data-theme-sun]").classList.toggle("hidden", !dark);
	document.querySelector("[data-theme-moon]").classList.toggle("hidden", dark);
	themeButton.setAttribute(
		"aria-label",
		dark ? "Switch to light theme" : "Switch to dark theme",
	);
};
updateIcon();
themeButton?.addEventListener("click", async () => {
	const next = !document.documentElement.classList.contains("dark");
	const apply = () => {
		document.documentElement.classList.toggle("dark", next);
		localStorage.setItem("litepod-theme", next ? "dark" : "light");
		updateIcon();
	};
	const start = document.startViewTransition?.bind(document);
	if (!start || window.matchMedia("(prefers-reduced-motion: reduce)").matches)
		return apply();
	const rect = themeButton.getBoundingClientRect();
	const x = rect.left + rect.width / 2;
	const y = rect.top + rect.height / 2;
	const radius = Math.hypot(
		Math.max(x, innerWidth - x),
		Math.max(y, innerHeight - y),
	);
	const transition = start(apply);
	await transition.ready;
	document.documentElement.animate(
		{
			clipPath: [
				`circle(0px at ${x}px ${y}px)`,
				`circle(${radius}px at ${x}px ${y}px)`,
			],
		},
		{
			duration: 600,
			easing: "cubic-bezier(0.4, 0, 0.2, 1)",
			pseudoElement: "::view-transition-new(root)",
		},
	);
});
</script>
